# Reuse the exact official amd64 runtime, including its entrypoint and users.
ARG BASE_IMAGE=xhofe/alist@sha256:499313cdb00ec53f60d9f00167df4ea737ca7f94f0d822673330f55bff8c9bfc
FROM ${BASE_IMAGE}
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/FV4004/Alist_bitqiu" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="v3.65.0-bitqiu.11" \
      org.opencontainers.image.description="AList v3.65.0 with BitQiu Windows client login, SMS device verification and original file download" \
      org.opencontainers.image.licenses="AGPL-3.0"
COPY --chmod=755 build/alist /opt/alist/alist
